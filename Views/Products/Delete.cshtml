@model EnterpriseStore.Web.Entities.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle p-2" title="Back">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h3 class="fw-bold mb-0 text-danger">Delete Product Confirmation</h3>
        </div>

        <div class="card shadow border-0 overflow-hidden">
            <div class="card-header bg-danger text-white py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                    <h5 class="mb-0 fw-bold">Permanent Removal</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-danger-subtle text-danger border border-danger-subtle rounded-3 mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0"></i>
                    <div>
                        <strong>Warning:</strong> Are you sure you want to delete this product? This action cannot be undone.
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold d-block">SKU</span>
                            <code>@Model.SKU</code>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Product ID</span>
                            <span class="text-dark fw-bold">#@Model.Id</span>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Product Name</span>
                            <span class="fs-5 fw-bold text-dark">@Model.Name</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Unit Price</span>
                            <span class="fw-bold text-success">@Model.Price.ToString("C")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Current Stock</span>
                            <span class="fw-bold text-dark">@Model.StockQuantity units</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 py-2 shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-trash3-fill"></i>
                        <span>Delete Permanently</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
