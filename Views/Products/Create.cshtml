@model EnterpriseStore.Web.Entities.Product

@{
    ViewData["Title"] = "Create Product";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle p-2" title="Back">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h3 class="fw-bold mb-0 text-dark">Add New Product</h3>
        </div>

        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle fs-5"></i>
                    <h5 class="mb-0 fw-bold">Product Information</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="SKU" class="form-label fw-semibold text-muted small text-uppercase">Stock Keeping Unit (SKU)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-upc-scan"></i></span>
                            <input asp-for="SKU" class="form-control form-control-lg" placeholder="e.g. PROD-SKU-100" required />
                        </div>
                        <span asp-validation-for="SKU" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold text-muted small text-uppercase">Product Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-tag"></i></span>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter product title" required />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="Price" class="form-label fw-semibold text-muted small text-uppercase">Price (USD)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">$</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="StockQuantity" class="form-label fw-semibold text-muted small text-uppercase">Stock Quantity</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-stack"></i></span>
                                <input asp-for="StockQuantity" type="number" min="0" class="form-control form-control-lg" placeholder="0" required />
                            </div>
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Save Product</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
